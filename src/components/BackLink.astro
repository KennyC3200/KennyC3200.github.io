---
// The single back link on secondary pages. `inline` keeps it in the page flow at every width.
import Icon from './Icon.astro';
interface Props { href: string; label: string; inline?: boolean; reveal?: boolean }
const { href, label, inline = false, reveal = false } = Astro.props;
---
<a class:list={['back-link', 'ui', { 'back-link--inline': inline }]} href={href} data-reveal={reveal ? 'intro' : undefined}>
  <Icon name="arrow-left" />{label}
</a>
