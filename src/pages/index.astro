---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { Content as About } from '../data/about.md';
import { site } from '../data/site';
import { getPosts, hasResume, isExternal, newTab, primaryLink } from '../lib/posts';

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const experience = (await getCollection('experience')).sort((a, b) =>
  (b.data.end ?? '9999').localeCompare(a.data.end ?? '9999') || b.data.start.localeCompare(a.data.start),
);

const posts = (await getPosts()).slice(0, 4);

const sections = [
  { id: 'about', label: 'About' },
  { id: 'experience', label: 'Experience' },
  { id: 'projects', label: 'Projects' },
  { id: 'blog', label: 'Blog' },
];
---
<Base reveal>
  <div class="page">
    <header class="left-col">
      {site.headshot && <img class="headshot" src={site.headshot} alt={site.name} width="96" height="96" data-reveal="intro" />}
      <h1 class="heading-1" data-reveal="intro">{site.name}</h1>
      <p class="heading-3 role" data-reveal="intro">{site.role}</p>
      <p class="tagline muted" data-reveal="intro">{site.tagline}</p>

      <nav class="section-nav" aria-label="Sections" data-reveal="intro">
        {sections.map((s, i) => (
          <a class:list={['nav-item', { 'is-active': i === 0 }]} href={`#${s.id}`} data-section={s.id}>
            <span class="nav-line"></span><span class="label">{s.label}</span>
          </a>
        ))}
      </nav>

      <div class="socials" data-reveal="intro">
        <a class="icon-link" href={site.github} {...newTab(site.github)} aria-label="GitHub"><Icon name="github" size={24} /></a>
        <a class="icon-link" href={site.linkedin} {...newTab(site.linkedin)} aria-label="LinkedIn"><span class="li-icon" aria-hidden="true"></span></a>
        <a class="icon-link" href={`mailto:${site.email}`} aria-label="Email"><Icon name="mail" size={24} /></a>
        {hasResume && <a class="icon-link" href={site.resume} target="_blank" rel="noopener" aria-label="Résumé"><Icon name="file-text" size={24} /></a>}
      </div>
    </header>

    <main id="main">
      <section id="about" aria-labelledby="about-title">
        <SectionHeading title="About" id="about-title" />
        <div class="about" data-reveal><About /></div>
      </section>

      <section id="experience" aria-labelledby="experience-title">
        <SectionHeading title="Experience" id="experience-title" />
        <ol class="rows rows--experience">
          {experience.map(({ data: r }) => (
            <li class="exp-row" data-reveal>
              <p class="label muted dates">{r.start} — {r.end ?? 'Present'}</p>
              <div class="stack">
                <h3 class="heading-3">
                  {r.url ? (
                    <a class="title-link with-icon" href={r.url} {...newTab(r.url)}>{r.role} · {r.company}<Icon name="arrow-up-right" /></a>
                  ) : (
                    <span>{r.role} · {r.company}</span>
                  )}
                </h3>
                {r.earlierRoles.map((t) => <p class="muted">{t}</p>)}
                <p>{r.description}</p>
                {r.tags.length > 0 && <ul class="tags">{r.tags.map((t) => <li class="tag">{t}</li>)}</ul>}
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section id="projects" aria-labelledby="projects-title">
        <SectionHeading title="Projects" id="projects-title" />
        <ul class="rows">
          {projects.map(({ data: p }) => {
            const href = primaryLink(p);
            return (
              <li class="media-row" data-reveal>
                <img class="thumb" src={p.thumbnail} alt="" width="160" height="100" loading="lazy" />
                <div class="stack">
                  <p class="label muted">{p.date.getUTCFullYear()}</p>
                  <h3 class="heading-3">
                    {href ? (
                      <a class="title-link with-icon" href={href} {...newTab(href)}>{p.name}{isExternal(href) && <Icon name="arrow-up-right" />}</a>
                    ) : (
                      <span>{p.name}</span>
                    )}
                  </h3>
                  <p>{p.description}</p>
                  {p.madeWith.length > 0 && <ul class="tags">{p.madeWith.map((t) => <li class="tag">{t}</li>)}</ul>}
                </div>
              </li>
            );
          })}
        </ul>
        <a class="text-link more" href="/projects" data-reveal>View all projects<Icon name="arrow-right" /></a>
      </section>

      <section id="blog" aria-labelledby="blog-title">
        <SectionHeading title="Blog" id="blog-title" />
        <ul class="rows">
          {posts.map((post) => (
            <li class="media-row media-row--post" data-reveal>
              <img class="thumb thumb--cover" src={post.data.cover} alt="" width="160" height="84" loading="lazy" />
              <div class="stack stack--tight">
                <p class="label muted">{post.data.date.getUTCFullYear()}</p>
                <h3 class="heading-3"><a class="title-link" href={`/blog/${post.id}`}>{post.data.title}</a></h3>
              </div>
            </li>
          ))}
        </ul>
        <a class="text-link more" href="/blog" data-reveal>All posts<Icon name="arrow-right" /></a>
      </section>

      <section id="contact" aria-labelledby="contact-title">
        <SectionHeading title="Contact" id="contact-title" />
        <p class="contact-text" data-reveal>{site.contact}</p>
        <div class="contact-actions" data-reveal>
          <a class="btn-primary" href={`mailto:${site.email}`}><Icon name="mail" />Email me</a>
          {hasResume && <a class="text-link" href={site.resume} target="_blank" rel="noopener"><Icon name="file-text" />Résumé</a>}
        </div>
      </section>

      <footer class="caption muted" data-reveal>{site.footer}</footer>
    </main>
  </div>
</Base>

<script>
  // Highlight the nav item of the section in view: the last section whose top has
  // scrolled above a line just below the sticky column's top.
  const items = [...document.querySelectorAll<HTMLAnchorElement>('.nav-item')];
  const sections = items.map((a) => document.getElementById(a.dataset.section!)).filter(Boolean) as HTMLElement[];
  let frame = 0;
  const update = () => {
    frame = 0;
    let active = sections[0]?.id;
    for (const s of sections) if (s.getBoundingClientRect().top <= 200) active = s.id;
    // At the very bottom, the last section counts as active even if it is short.
    if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) active = sections.at(-1)?.id;
    for (const a of items) {
      const on = a.dataset.section === active;
      a.classList.toggle('is-active', on);
      if (on) a.setAttribute('aria-current', 'location');
      else a.removeAttribute('aria-current');
    }
  };
  const onScroll = () => { if (!frame) frame = requestAnimationFrame(update); };
  addEventListener('scroll', onScroll, { passive: true });
  addEventListener('resize', onScroll);
  update();
</script>

<style>
  .page {
    max-width: var(--width-content-wide);
    margin: 0 auto;
    padding: var(--space-3xl) var(--space-2xl);
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    column-gap: var(--space-2xl);
    align-items: start;
  }
  .left-col { position: sticky; top: var(--space-3xl); max-width: 440px; display: flex; flex-direction: column; }
  .headshot { width: 96px; height: 96px; border-radius: var(--radius-full); margin-bottom: var(--space-lg); }
  .role { margin-top: var(--space-sm); }
  .tagline { margin-top: var(--space-md); max-width: 320px; }

  .section-nav { margin-top: var(--space-3xl); display: flex; flex-direction: column; gap: var(--space-md); }
  .nav-item { display: flex; align-items: center; gap: var(--space-md); width: fit-content; color: var(--color-muted); text-decoration: none; transition: color 150ms ease; }
  .nav-line { display: block; width: 32px; height: 1px; background: var(--color-muted); transition: width 150ms ease, background-color 150ms ease; }
  .nav-item:hover, .nav-item.is-active { color: var(--color-text); }
  .nav-item:hover .nav-line, .nav-item.is-active .nav-line { width: 64px; background: var(--color-text); }
  @media (prefers-reduced-motion: reduce) { .nav-item, .nav-line { transition: none; } }

  .socials { margin-top: var(--space-2xl); display: flex; align-items: center; gap: var(--space-lg); }
  .li-icon { display: block; width: 22px; height: 22px; margin: 1px; }

  main { min-width: 0; display: flex; flex-direction: column; gap: var(--space-3xl); }
  /* Section headings sit under the window's top edge when jumped to from the nav. */
  section { scroll-margin-top: var(--space-3xl); }

  .about { display: flex; flex-direction: column; gap: var(--space-md); }
  .about :global(strong) { font-weight: 600; }

  .rows { list-style: none; padding: 0; display: flex; flex-direction: column; gap: var(--space-xl); }
  .rows--experience { gap: var(--space-2xl); }
  .stack { display: flex; flex-direction: column; gap: var(--space-sm); min-width: 0; }
  .stack--tight { gap: var(--space-xs); }
  .stack .tags { margin-top: var(--space-sm); }
  .with-icon { display: inline-flex; align-items: center; gap: var(--space-xs); }

  .exp-row { display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); column-gap: var(--space-md); row-gap: var(--space-sm); }
  .exp-row .dates { grid-column: span 2; padding-top: var(--space-xs); }
  .exp-row .stack { grid-column: span 6; }

  .media-row { display: flex; flex-wrap: wrap; gap: var(--space-lg); align-items: flex-start; }
  .media-row--post { align-items: center; }
  .media-row .stack { flex: 1 1 280px; }
  .thumb { width: 160px; height: 100px; object-fit: cover; border-radius: var(--radius-md); border: 1px solid var(--color-border); flex: 0 0 auto; }
  .thumb--cover { height: 84px; }

  .more { margin-top: var(--space-xl); }

  .contact-text { max-width: 520px; margin-bottom: var(--space-lg); }
  .contact-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-lg); }
  .btn-primary {
    display: inline-flex; align-items: center; gap: var(--space-sm); min-height: 44px;
    padding: var(--space-sm) var(--space-lg); border-radius: var(--radius-md);
    background: var(--color-accent); color: var(--color-on-accent); font-weight: 600; text-decoration: none;
  }
  .btn-primary:hover { background: var(--color-accent-hover); color: var(--color-on-accent); }

  footer { max-width: 480px; }

  @media (max-width: 1023px) {
    .page { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-2xl); }
    .left-col { position: static; }
    .section-nav { display: none; }
  }
  @media (max-width: 639px) {
    .page { padding: var(--space-2xl) var(--space-md); }
    .exp-row .dates, .exp-row .stack { grid-column: 1 / -1; }
  }
</style>
