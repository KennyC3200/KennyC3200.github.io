---
import type { GetStaticPaths, Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BackLink from '../../components/BackLink.astro';
import Icon from '../../components/Icon.astro';
import PostMeta from '../../components/PostMeta.astro';
import { site } from '../../data/site';
import { getPosts } from '../../lib/posts';

// /blog, then /blog/2, /blog/3… once there are more posts than fit on one page.
export const getStaticPaths = (async ({ paginate }) => {
  return paginate(await getPosts(), { pageSize: site.postsPerPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props as { page: Page<CollectionEntry<'blog'>> };
---
<Base title="Blog" description={site.blogIntro} reveal>
  <main id="main" class="wrap">
    <BackLink href="/" label={site.name} reveal />
    <h1 class="heading-1" data-reveal="intro">Blog</h1>
    <p class="intro muted" data-reveal="intro">{site.blogIntro}</p>

    <ol class="posts">
      {page.data.map((post) => (
        <li data-reveal>
          <article class="card">
            <h2 class="heading-2"><a class="title-link" href={`/blog/${post.id}`}>{post.data.title}</a></h2>
            <PostMeta date={post.data.date} body={post.body} />
            <p class="excerpt">{post.data.description}</p>
            <div class="divider"></div>
            <div class="card-foot">
              {post.data.tags.length > 0 ? (
                <span class="caption muted post-tags"><Icon name="tag" /><span class="sr-only">Tags: </span>{post.data.tags.join(', ')}</span>
              ) : <span></span>}
              <a class="read-more" href={`/blog/${post.id}`} aria-label={`Read more: ${post.data.title}`}>Read more<Icon name="arrow-right" /></a>
            </div>
          </article>
        </li>
      ))}
    </ol>

    {(page.url.prev || page.url.next) && (
      <nav class="pagination" aria-label="Pagination" data-reveal>
        {page.url.prev ? <a class="read-more" href={page.url.prev}><Icon name="arrow-left" />Newer posts</a> : <span></span>}
        {page.url.next && <a class="read-more" href={page.url.next}>Older posts<Icon name="arrow-right" /></a>}
      </nav>
    )}
  </main>
</Base>

<style>
  .wrap { max-width: var(--width-content-narrow); margin: 0 auto; box-sizing: content-box; padding: var(--space-3xl) var(--space-2xl); }
  .intro { margin-top: var(--space-md); }
  .posts { list-style: none; padding: 0; margin-top: var(--space-xl); display: flex; flex-direction: column; gap: var(--space-lg); }
  .card { border: 1.5px solid var(--color-border); border-radius: var(--radius-md); padding: var(--space-lg); display: flex; flex-direction: column; }
  .excerpt {
    margin-top: var(--space-md); font-family: var(--font-serif); font-size: 18px; line-height: 1.7;
    display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .divider { height: 1.5px; background: var(--color-border); margin: var(--space-md) 0; }
  .card-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-md); }
  .post-tags { display: inline-flex; align-items: center; gap: var(--space-xs); }
  .read-more { display: inline-flex; align-items: center; gap: var(--space-xs); font-weight: 500; text-decoration: none; }
  .pagination { margin-top: var(--space-xl); display: flex; justify-content: space-between; gap: var(--space-lg); }
  @media (max-width: 639px) {
    .wrap { padding: var(--space-2xl) var(--space-md); }
  }
</style>
